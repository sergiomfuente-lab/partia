generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id               String    @id @default(cuid())
  nombre           String
  nombreFiscal     String?
  cifNif           String?
  direccionFiscal  String?
  codigoPostal     String?
  ciudad           String?
  provincia        String?
  telefono         String?
  emailFacturacion String?
  iban             String?
  logoBase64       String?
  textoRgpd        String?
  precioHora       Float     @default(55)
  precioPorKm      Float     @default(0.35)
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  usuarios         Usuario[] @relation("UsuarioEmpresa")
  usuariosActivos  Usuario[] @relation("UsuarioEmpresaActiva")
  clientes         Cliente[]
  contadores       ContadorFactura[]
  contadoresPresupuesto ContadorPresupuesto[]
  contadoresOrden  ContadorOrden[]
  ordenes          Orden[]
  proveedores      Proveedor[]
  productos        Producto[]
  compras          Compra[]
  presupuestos     Presupuesto[]
  series           SerieFacturacion[]
  abonos           Abono[]
  facturas         Factura[]

  // Veri*Factu / RRSIF (Real Decreto 1007/2023) — configuración por empresa,
  // a rellenar una vez la gestoría confirme régimen y modalidad aplicables.
  facturacionInmutableActiva Boolean   @default(false)
  regimenFiscalVerifactu     String?
  verifactuModalidad         String?
  verifactuFechaLimite       DateTime?
  verifactuNotasGestoria     String?
  ultimaHuellaFactura        String?
}

model Usuario {
  id                  String    @id @default(cuid())
  nombre              String
  email               String    @unique
  password            String
  rol                 String    @default("tecnico")
  activo              Boolean   @default(true)
  debeCambiarPassword Boolean   @default(false)
  empresaId           String?
  empresaActivaId     String?
  empresa             Empresa?  @relation("UsuarioEmpresa", fields: [empresaId], references: [id])
  empresaActiva       Empresa?  @relation("UsuarioEmpresaActiva", fields: [empresaActivaId], references: [id])
  createdAt           DateTime  @default(now())
  clientes            Cliente[]
  dni                 String?
  ordenesAsignadas    Orden[]
  comprasRegistradas  Compra[]
  facturasPagadas     Factura[]
}

model ContadorFactura {
  id        String   @id @default(cuid())
  anio      Int
  contador  Int      @default(0)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([empresaId, anio])
}

model ContadorPresupuesto {
  id        String   @id @default(cuid())
  anio      Int
  contador  Int      @default(0)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([empresaId, anio])
}

model ContadorOrden {
  id        String   @id @default(cuid())
  contador  Int      @default(0)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([empresaId])
}

model SerieFacturacion {
  id             String    @id @default(cuid())
  nombre         String
  prefijo        String
  contadorActual Int       @default(0)
  prefijoAbono   String
  contadorAbono  Int       @default(0)
  predeterminada Boolean   @default(false)
  activa         Boolean   @default(true)
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  facturas       Factura[]
  abonos         Abono[]
  createdAt      DateTime  @default(now())
}

model Cliente {
  id                   String        @id @default(cuid())
  nombre               String
  nombreComercial      String?
  razonSocial          String?
  cif                  String?
  direccionFacturacion String?
  formaPago            String?       @default("Transferencia bancaria")
  plazoPagoDias        Int?
  email                String?
  telefono             String?
  tipo                 String        @default("empresa")
  observaciones        String?
  precioHoraEspecial   Float?
  precioPorKmEspecial  Float?
  activo               Boolean       @default(true)
  mostrarPrecios       Boolean       @default(true)
  empresaId            String
  empresa              Empresa       @relation(fields: [empresaId], references: [id])
  usuarioId            String?
  usuario              Usuario?      @relation(fields: [usuarioId], references: [id])
  maquinas             Maquina[]
  facturas             Factura[]
  ordenes              Orden[]
  presupuestos         Presupuesto[]
  createdAt            DateTime      @default(now())
}

model Maquina {
  id             String        @id @default(cuid())
  marca          String
  modelo         String
  numeroDeSerie  String
  matricula      String?
  horasIniciales Float         @default(0)
  horasActuales  Float         @default(0)
  observaciones  String?
  estado         String        @default("activo")
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  ordenes        Orden[]
  presupuestos   Presupuesto[]
  createdAt      DateTime      @default(now())
}

model TipoServicio {
  id           String        @id @default(cuid())
  nombre       String
  unidad       String        @default("ud")
  activo       Boolean       @default(true)
  orden        Int           @default(0)
  createdAt    DateTime      @default(now())
  servicios    Servicio[]
  facturaLineas FacturaLinea[]
}

model Orden {
  id                  String            @id @default(cuid())
  numero              String
  empresaId           String
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  fecha               DateTime          @default(now())
  direccionReparacion String?
  trabajosRealizados  String?
  observaciones       String?
  estado              String            @default("pendiente")
  mostrarPrecios      Boolean           @default(true)
  firmaDni            String?
  firmaObservaciones  String?
  firmaBase64         String?
  clienteId           String
  cliente             Cliente           @relation(fields: [clienteId], references: [id])
  maquinaId           String
  maquina             Maquina           @relation(fields: [maquinaId], references: [id])
  tecnicoId           String?
  tecnico             Usuario?          @relation(fields: [tecnicoId], references: [id])
  horasTrabajo        Float             @default(0)
  sesionesTrabajo     SesionTrabajo[]
  servicios           Servicio[]
  serviciosLibres     ServicioLibre[]
  repuestos           Repuesto[]
  facturaId           String?
  factura             Factura?          @relation(fields: [facturaId], references: [id])
  presupuestoId       String?
  presupuesto         Presupuesto?      @relation(fields: [presupuestoId], references: [id])
  lineasCompra        CompraLinea[]
  movimientosStock    MovimientoStock[]
  createdAt           DateTime          @default(now())

  @@unique([empresaId, numero])
}

// Registra cada tramo de trabajo real sobre una orden (desde que el
// tecnico pulsa "empezar"/"reanudar" hasta que pausa o completa). Sirve
// para calcular Orden.horasTrabajo y para tener un historial auditable.
model SesionTrabajo {
  id        String    @id @default(cuid())
  ordenId   String
  orden     Orden     @relation(fields: [ordenId], references: [id])
  inicio    DateTime  @default(now())
  fin       DateTime?
  createdAt DateTime  @default(now())
}

model Servicio {
  id             String       @id @default(cuid())
  fecha          DateTime     @default(now())
  tipoServicioId String
  tipoServicio   TipoServicio @relation(fields: [tipoServicioId], references: [id])
  cantidad       Float        @default(0)
  precio         Float        @default(0)
  descripcion    String?
  ordenId        String
  orden          Orden        @relation(fields: [ordenId], references: [id])
  createdAt      DateTime     @default(now())
}

model ServicioLibre {
  id            String       @id @default(cuid())
  descripcion   String
  cantidad      Float        @default(1)
  precio        Float        @default(0)
  ordenId       String?
  orden         Orden?       @relation(fields: [ordenId], references: [id])
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id])
  createdAt     DateTime     @default(now())
}

model Repuesto {
  id            String       @id @default(cuid())
  referencia    String?
  descripcion   String
  cantidad      Float        @default(1)
  precioCoste   Float
  precioVenta   Float
  ordenId       String?
  orden         Orden?       @relation(fields: [ordenId], references: [id])
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id])
}

model Factura {
  id             String           @id @default(cuid())
  numero         String
  empresaId      String
  empresa        Empresa          @relation(fields: [empresaId], references: [id])
  fecha          DateTime         @default(now())
  vencimiento    DateTime?
  estado         String           @default("pendiente")
  baseImponible  Float            @default(0)
  descuento      Float            @default(0)
  tipoDescuento  String           @default("euro")
  descuentoValor Float            @default(0)
  iva            Float            @default(21)
  total          Float            @default(0)
  notas          String?
  esDirecta      Boolean          @default(false)
  serieId        String?
  serie          SerieFacturacion? @relation(fields: [serieId], references: [id])
  clienteId      String
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  ordenes        Orden[]
  lineasDirectas FacturaLinea[]
  abonos         Abono[]
  createdAt      DateTime         @default(now())

  // Veri*Factu / RRSIF: huella (hash) encadenada del registro de facturación
  huella              String?
  huellaAnterior      String?
  fechaHoraHuella     DateTime?

  // Registro de quién y cuándo marcó la factura como pagada
  fechaPago           DateTime?
  pagadoPorId         String?
  pagadoPor           Usuario?  @relation(fields: [pagadoPorId], references: [id])

  @@unique([empresaId, numero])
}

model FacturaLinea {
  id             String        @id @default(cuid())
  facturaId      String
  factura        Factura       @relation(fields: [facturaId], references: [id])
  tipo           String        @default("libre")
  tipoServicioId String?
  tipoServicio   TipoServicio? @relation(fields: [tipoServicioId], references: [id])
  descripcion    String
  cantidad       Float         @default(1)
  precioCoste    Float         @default(0)
  precioVenta    Float         @default(0)
  createdAt      DateTime      @default(now())
}

model Abono {
  id            String           @id @default(cuid())
  numero        String
  fecha         DateTime         @default(now())
  facturaId     String
  factura       Factura          @relation(fields: [facturaId], references: [id])
  serieId       String
  serie         SerieFacturacion @relation(fields: [serieId], references: [id])
  tipo          String           @default("total")
  baseImponible Float            @default(0)
  iva           Float            @default(21)
  total         Float            @default(0)
  motivo        String?
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id])
  lineas        AbonoLinea[]
  createdAt     DateTime         @default(now())

  // Veri*Factu / RRSIF: tipo de rectificativa (R1-R5) y huella encadenada
  tipoRectificacion   String?   @default("R1")
  huella              String?
  huellaAnterior      String?
  fechaHoraHuella     DateTime?

  @@unique([empresaId, numero])
}

model AbonoLinea {
  id          String  @id @default(cuid())
  abonoId     String
  abono       Abono   @relation(fields: [abonoId], references: [id])
  descripcion String
  cantidad    Float   @default(1)
  precio      Float   @default(0)
  total       Float   @default(0)
}

model Presupuesto {
  id                  String          @id @default(cuid())
  numero              String
  fecha               DateTime        @default(now())
  validezHasta        DateTime?
  estado              String          @default("borrador")
  direccionReparacion String?
  descripcion         String?
  observaciones       String?
  baseImponible       Float           @default(0)
  descuento           Float           @default(0)
  tipoDescuento       String          @default("euro")
  descuentoValor      Float           @default(0)
  iva                 Float           @default(21)
  total               Float           @default(0)
  notas               String?
  clienteId           String
  cliente             Cliente         @relation(fields: [clienteId], references: [id])
  maquinaId           String?
  maquina             Maquina?        @relation(fields: [maquinaId], references: [id])
  empresaId           String
  empresa             Empresa         @relation(fields: [empresaId], references: [id])
  ordenes             Orden[]
  serviciosLibres     ServicioLibre[]
  repuestos           Repuesto[]
  createdAt           DateTime        @default(now())

  @@unique([empresaId, numero])
}

model Proveedor {
  id        String    @id @default(cuid())
  nombre    String
  cif       String?
  direccion String?
  telefono  String?
  email     String?
  contacto  String?
  activo    Boolean   @default(true)
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  compras   Compra[]
  createdAt DateTime  @default(now())
}

model Producto {
  id           String            @id @default(cuid())
  referencia   String?
  nombre       String
  descripcion  String?
  precioCoste  Float             @default(0)
  precioVenta  Float             @default(0)
  stock        Float             @default(0)
  stockMinimo  Float             @default(0)
  unidad       String            @default("ud")
  activo       Boolean           @default(true)
  empresaId    String
  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  movimientos  MovimientoStock[]
  lineasCompra CompraLinea[]
  createdAt    DateTime          @default(now())
}

model Compra {
  id               String        @id @default(cuid())
  fecha            DateTime      @default(now())
  numeroAlbaran    String?
  proveedorId      String?
  proveedor        Proveedor?    @relation(fields: [proveedorId], references: [id])
  proveedorNombre  String?
  total            Float         @default(0)
  observaciones    String?
  // Foto del ticket/albaran (compras registradas por el tecnico desde el
  // movil, sin poder guardar el papel fisico).
  fotoTicketBase64 String?
  // Tecnico que registro la compra (opcional: tambien la puede dar de alta
  // la oficina manualmente, sin tecnico asociado).
  tecnicoId        String?
  tecnico          Usuario?      @relation(fields: [tecnicoId], references: [id])
  empresaId        String
  empresa          Empresa       @relation(fields: [empresaId], references: [id])
  lineas           CompraLinea[]
  createdAt        DateTime      @default(now())
}

model CompraLinea {
  id          String    @id @default(cuid())
  compraId    String
  compra      Compra    @relation(fields: [compraId], references: [id])
  productoId  String?
  producto    Producto? @relation(fields: [productoId], references: [id])
  descripcion String
  referencia  String?
  cantidad    Float     @default(1)
  precioCoste Float     @default(0)
  precioVenta Float     @default(0)
  aStock      Boolean   @default(false)
  ordenId     String?
  orden       Orden?    @relation(fields: [ordenId], references: [id])
  createdAt   DateTime  @default(now())
}

model MovimientoStock {
  id          String   @id @default(cuid())
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])
  tipo        String
  cantidad    Float
  precioCoste Float    @default(0)
  ordenId     String?
  orden       Orden?   @relation(fields: [ordenId], references: [id])
  compraId    String?
  motivo      String?
  createdAt   DateTime @default(now())
}